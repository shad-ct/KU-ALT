# ==============================================================================
# Kannur University R&D Cell Unified Portal - Environment Variables
# ==============================================================================

NODE_ENV=development
PORT=5000

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kannur_rd_db
DB_USER=kannur_user
DB_PASSWORD=kannur_pass
DB_ROOT_PASSWORD=rootpassword
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT Secrets (generate strong random secrets in production)
JWT_ACCESS_SECRET=kannur_university_rd_cell_access_secret_2026
JWT_REFRESH_SECRET=kannur_university_rd_cell_refresh_secret_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Local File Storage
UPLOAD_DIR=./data/uploads

# Mail Settings (MailHog for local dev)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kannur University R&D Cell <rdcell@kannuruniversity.ac.in>"

