{
  "name": "kannur-rd-server",
  "version": "1.0.0",
  "description": "Kannur University R&D Cell Unified Portal Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrator.js up",
